{
  "name": "@openclaw/tradecraft-plugin",
  "version": "0.1.0",
  "description": "TradeCraft multi-agent resource trading game plugin for RL training.",
  "type": "module",
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@openclaw/tradecraft-plugin",
      "defaultChoice": "local",
      "allowInvalidConfigRecovery": true
    },
    "compat": {
      "pluginApi": ">=2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1"
    }
  }
}
